# Ortam Değişkenleri — .env.example
# Bu dosyayı .env olarak kopyalayın:
#   cp .env.example .env
# .env dosyasını git'e EKLEMEYIN (.gitignore'da zaten var)

# JWT imzalama anahtarı — üretimde güçlü bir değer kullanın
JWT_SECRET=change-me-in-production

# Grafana admin şifresi
GRAFANA_PASSWORD=admin

# Log seviyesi (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Rate limiting (istek/dakika/IP)
RATE_LIMIT_PER_MINUTE=100
